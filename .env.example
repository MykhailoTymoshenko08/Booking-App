# Рядок підключення до PostgreSQL
# Локально (з піднятою БД через `docker-compose up db -d`):
#   postgresql://postgres:booking@localhost:5432/booking?schema=public
# Docker Compose (сервіс app всередині мережі compose):
#   postgresql://postgres:booking@db:5432/booking?schema=public
DATABASE_URL="postgresql://postgres:booking@localhost:5432/booking?schema=public"

# Довгий випадковий рядок (мінімум 32 символи) для підпису сесійних JWT
JWT_SECRET="replace-with-a-long-random-string-min-32-chars"

# За скільки хвилин до кінця бронювання показувати сповіщення автору,
# якщо наступний слот у кімнаті вже зайнятий (тост/дзвіночок у BookingCalendar)
NOTIFY_BEFORE_MINUTES=10
