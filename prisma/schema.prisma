generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String
  passwordHash       String
  isVerified         Boolean             @default(false)
  bookings           Booking[]
  verificationTokens VerificationToken[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("users")
}

// Одноразовий токен для підтвердження email (dev-режим: посилання лише
// логується в консоль сервера, реальний SMTP не потрібен).
model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("verification_tokens")
}

model Room {
  id       String    @id @default(cuid())
  name     String
  floor    Int
  capacity Int
  bookings Booking[]

  @@map("rooms")
}

model Booking {
  id        String   @id @default(cuid())
  title     String
  startTime DateTime
  endTime   DateTime

  // Спільний ідентифікатор для серії повторюваних бронювань (напр. "щовівторка,
  // 8 повторень"). null для звичайного одноразового бронювання. Дозволяє
  // скасувати або один конкретний запис, або всю серію одразу.
  seriesId String?

  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())

  @@index([roomId, startTime, endTime])
  @@index([seriesId])
  @@map("bookings")
}
